{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": { "Path": "/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/basket" } ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/payments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/payments" } ]
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5001/" } }
      },
      "catalog-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5002/" } }
      },
      "basket-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      },
      "orders-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5004/" } }
      },
      "payments-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5005/" } }
      }
    }
  }
}
